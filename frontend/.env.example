# ========================================
# AlgoVerse Frontend Environment Template
# ========================================
# Copy this to .env and adjust as needed:
#   cp .env.example .env
#
# Only VITE_-prefixed variables are exposed to the browser bundle. They are
# read in exactly one place, src/services/api.js, so keep those two in sync.

# ---------- Backend URL ----------
# api.js resolves its base URL as:
#   dev  (npm run dev)    -> http://localhost:8000, hardcoded
#   prod (npm run build)  -> VITE_API_URL
#                            || VITE_PROD_API_BASE_URL
#                            || https://algoverse-kpwz.onrender.com
#
# Note the name: VITE_API_URL holds the *backend* API base URL, not this app's
# URL. Leaving both blank is valid - production then uses the built-in default.
VITE_API_URL=
VITE_PROD_API_BASE_URL=

# ---------- Environment label ----------
# Informational only. api.js decides dev vs prod from import.meta.env.MODE,
# which Vite sets from the command, so changing this line does NOT switch the
# API target. .env.production (committed) sets it to "production".
VITE_ENVIRONMENT=development

# ---------- Not read by any code ----------
# Older local .env files may still define VITE_DEV_API_BASE_URL,
# VITE_DEV_FRONTEND_URL and VITE_PROD_FRONTEND_URL. Nothing imports them;
# the dev API URL is hardcoded in api.js. Safe to delete if you see them.

# ========================================
# NOTES
# 1. .env files are gitignored - never commit credentials.
# 2. In development, vite.config.js proxies /api/* to the production Render
#    backend, so anything under /api works without a local server; every other
#    path still needs http://localhost:8000 running.
# 3. The backend must list this origin in its CORS config, or requests fail
#    with a network error before the browser shows a status code.
# ========================================
