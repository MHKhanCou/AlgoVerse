# ========================================
# AlgoVerse Environment Configuration
# ========================================
# Copy this to .env and fill in real values:
#   cp .env.example .env

# Environment: development | production
ENVIRONMENT=development

# ---------- Development ----------
DEV_DATABASE_URL=sqlite:///./algoverse.db
DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEV_FRONTEND_URL=http://localhost:5173
DEV_BACKEND_URL=http://localhost:8000

# ---------- Production ----------
# Format: postgresql://user:password@host:port/dbname
PROD_DATABASE_URL=
# Optional override. Takes priority over DEV_DATABASE_URL and
# PROD_DATABASE_URL above, and is what Render sets for the deployed service.
# NOTE: any postgresql:// URL here flips the app into production mode, so
# leaving it pointed at a live database makes local runs write to real data.
DATABASE_URL=
# Comma-separated. Do NOT add localhost here: the API sends credentials, so a
# localhost origin would let any page on any developer machine call production.
PROD_CORS_ORIGINS=https://your-frontend.vercel.app
PROD_FRONTEND_URL=https://your-frontend.vercel.app
PROD_BACKEND_URL=https://your-backend.onrender.com

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ---------- Email (Gmail App Password) ----------
# 1. Enable 2FA on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
DISABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=AlgoVerse <your-email@gmail.com>

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
BCRYPT_ROUNDS=12

# ---------- Redis (optional contest cache) ----------
# Read via os.getenv in app/db/redis_client.py, not through Settings, so these
# must be real environment variables. Caching is skipped silently when Redis is
# unreachable, and REDIS_HOST defaults to localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- AI practice-problem suggestions (optional) ----------
# The model only SELECTS from real problems (Codeforces API + curated CSES
# tasks) and its output is validated against that pool, so links are never
# invented. Leave AI_API_KEY empty to disable the model pass; suggestions
# still work, ranked deterministically. Any OpenAI-compatible endpoint works
# (OpenAI, OpenRouter, Groq, DeepSeek, Gemini's OpenAI-compatible URL, ...).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

# ---------- App Settings ----------
DEBUG=true
# Creates tables from the models on startup. Automatic in development; in
# production it does nothing unless you set this to true explicitly, so a
# deploy never mutates a live schema by accident. Prefer alembic migrations.
AUTO_CREATE_TABLES=false
BASE_URL=http://localhost:8000
